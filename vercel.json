{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": true,
  "redirects": [
    { "source": "/hvac", "destination": "https://hvac.webdemos.app/", "permanent": false },
    { "source": "/hvac/:path*", "destination": "https://hvac.webdemos.app/:path*", "permanent": false },
    { "source": "/clothing-boutique", "destination": "https://boutique.webdemos.app/", "permanent": false },
    { "source": "/clothing-boutique/:path*", "destination": "https://boutique.webdemos.app/:path*", "permanent": false },
    { "source": "/real-estate", "destination": "https://realestate.webdemos.app/", "permanent": false },
    { "source": "/real-estate/:path*", "destination": "https://realestate.webdemos.app/:path*", "permanent": false }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
